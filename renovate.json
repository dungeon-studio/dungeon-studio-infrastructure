{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>dungeon-studio/renovate-config",
    "github>dungeon-studio/renovate-config:automerge-minor"
  ],
  "packageRules": [
    {
      "description": "CI cannot plan the bootstrap layer",
      "matchFileNames": ["terraform/bootstrap/**"],
      "automerge": false
    },
    {
      "description": "Each bootstrap run needs fresh Grafana Cloud and Cloudflare tokens",
      "matchFileNames": ["terraform/bootstrap/**"],
      "groupName": "bootstrap layer"
    },
    {
      "description": "A newer terraform can write state an older one cannot read, so reverting a bump after it applies may not recover",
      "matchManagers": ["mise"],
      "matchDepNames": ["terraform"],
      "automerge": false
    }
  ]
}
